{
  "name": "deepseek-stream-archive",
  "version": "0.1.0",
  "description": "Local-first browser extension that records DeepSeek responses while they stream, preserves revisions before filtering or failure, and provides recovery, search and archival.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.5",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "compile": "wxt build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.6.4",
    "@wxt-dev/module-svelte": "^2.0.5",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^21.0.4",
    "svelte": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wxt": "^0.21.0"
  }
}
